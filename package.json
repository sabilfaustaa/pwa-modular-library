{
  "name": "pwa-modular-library",
  "version": "1.0.0-rc.1",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vite build && vue-tsc --emitDeclarationOnly",
    "dev": "vite build --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint src/ tests/ --ext .ts",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "prepack": "pnpm build",
    "prepare": "husky"
  },
  "keywords": [
    "pwa",
    "vue",
    "typescript",
    "service-worker",
    "caching",
    "push-notification",
    "background-sync"
  ],
  "author": "Muhamad Sabil Fausta",
  "license": "MIT",
  "description": "Library modular untuk akselerasi implementasi Progressive Web Apps berbasis Vue.js 3 dan TypeScript.",
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "dependencies": {
    "date-fns": "^3.0.0",
    "idb": "^8.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.0",
    "@commitlint/config-conventional": "^21.0.0",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitest/coverage-v8": "^1.6.0",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "esbuild": "^0.28.0",
    "eslint": "^8.55.0",
    "eslint-plugin-vue": "^9.20.0",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^14.0.0",
    "husky": "^9.1.7",
    "msw": "^2.0.0",
    "prettier": "^3.1.0",
    "typescript": "^5.3.0",
    "vite": "^5.4.0",
    "vite-plugin-dts": "^3.7.0",
    "vitest": "^1.6.0",
    "vue": "^3.4.0",
    "vue-tsc": "^2.0.0"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
